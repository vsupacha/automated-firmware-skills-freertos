{
  "baud": 115200,
  "boot": {"expect": "READY", "timeout": 30},
  "sync": {"send": "info", "expect": "READY"},
  "steps": [
    {"name": "info", "send": "info", "expect_re": ["^INFO app=blink .*period_ms=500 rtos=FreeRTOS V\\d"]},
    {"name": "LED1 on+off 1", "expect": ["BLINK led1=1", "BLINK led1=0"], "timeout": 1.5, "pause": 0},
    {"name": "LED1 on+off 2", "expect": ["BLINK led1=1", "BLINK led1=0"], "timeout": 1.5, "pause": 0},
    {"name": "tasks + stack", "send": "tasks", "expect_re": ["^TASK name=ledTask state=\\w+ prio=\\d+ stack_free=([5-9]\\d|\\d{3,})$", "^TASK name=console state=\\w+ prio=1 stack_free=([5-9]\\d|\\d{3,})$", "^HEAP free=\\d+ min=\\d+ total=16384 tasks=\\d+$"]},
    {"name": "console alive", "send": "foo", "expect": ["ERR unknown command"]},
    {"name": "LED1 blinks (look)", "interactive": true, "prompt": "Look at the board: LED1 should toggle every 0.5 s (0.5 s on, 0.5 s off) - tell Claude", "expect": ["BLINK led1=1", "BLINK led1=0"], "timeout": 5}
  ]
}
